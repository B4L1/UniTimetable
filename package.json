{
  "name": "unitimetable-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "UniTimetable - Web and Mobile apps for university timetable management",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:web": "pnpm --filter @unitimetable/web dev",
    "build:web": "pnpm --filter @unitimetable/web build",
    "dev:mobile": "pnpm --filter @unitimetable/mobile start",
    "build:mobile:android": "pnpm --filter @unitimetable/mobile run android",
    "build:mobile:ios": "pnpm --filter @unitimetable/mobile run ios",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec -- rm -rf node_modules && rm -rf node_modules"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
